# ── LLM ────────────────────────────────────────────────────────────────────
# Your OpenAI API key (used for answer generation in Week 3)
OPENAI_API_KEY=sk-...

# Model to use for answer generation
OPENAI_MODEL=gpt-4o-mini

# ── GitMind Storage ─────────────────────────────────────────────────────────
# Where GitMind stores its local database and indexes
# Defaults to ~/.gitmind/ if not set
GITMIND_DATA_DIR=~/.gitmind

# ── Retrieval ────────────────────────────────────────────────────────────────
# Confidence threshold for episode retrieval gate (0.0 - 1.0)
# Episodes with similarity below this are dropped to prevent answer degradation
GITMIND_EPISODE_GATE_THRESHOLD=0.72

# Embedding model for the episode store
GITMIND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Linking ──────────────────────────────────────────────────────────────────
# Time window (in seconds) to search for sessions near a commit
# Default: 7200 = ±2 hours
GITMIND_LINK_TIME_WINDOW_SECONDS=7200

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
GITMIND_LOG_LEVEL=INFO
